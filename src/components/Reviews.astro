---
// Placeholder reviews: swap each entry for a real customer name, location
// and quote once Petr has reviews to show. Structure below already supports it.
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].reviews;
---

<section id="reviews" class="reviews_wrap u-section u-theme-light">
  <style>
    .reviews_content {
      max-width: var(--max-width--small);
      margin-left: auto;
      margin-right: auto;
      margin-bottom: var(--_spacing---space--8);
    }

    .reviews_eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      gap: var(--_spacing---space--2);
      margin-bottom: var(--_spacing---space--4);
    }

    .reviews_eyebrow_dot {
      width: 0.4rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: var(--radius--round);
      background-color: var(--_theme---accent);
    }

    .reviews_eyebrow_number {
      color: var(--_theme---accent);
      font-weight: var(--_typography---font--primary-bold);
    }

    .reviews_eyebrow_label {
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: color-mix(in hsl, currentColor 65%, transparent);
    }

    .reviews_title {
      max-width: 20ch;
      margin-bottom: var(--_text-style---margin-bottom);
    }

    .reviews_text {
      max-width: 42ch;
      color: color-mix(in hsl, currentColor 75%, transparent);
    }

    .reviews_grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--_spacing---space--5);
    }

    @container (width < 50em) {
      .reviews_grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }

    .reviews_card_wrap {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: var(--_spacing---space--6);
      background-color: var(--_theme---background-2);
      color: var(--_theme---text);
      border-radius: var(--radius--main);
    }

    .reviews_card_stars_wrap {
      display: flex;
      gap: 0.2rem;
      margin-bottom: var(--_spacing---space--3);
    }

    .reviews_card_star {
      width: 1.125rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      fill: none;
    }

    .reviews_card_star_path {
      stroke: var(--_theme---accent);
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .reviews_card_quote {
      margin-bottom: var(--_spacing---space--4);
      color: color-mix(in hsl, currentColor 85%, transparent);
      font-style: italic;
    }

    .reviews_card_author_wrap {
      display: flex;
      align-items: center;
      gap: var(--_spacing---space--3);
      margin-top: auto;
    }

    .reviews_card_avatar_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: var(--radius--round);
      background-color: var(--_theme---background-skeleton);
      color: color-mix(in hsl, currentColor 60%, transparent);
    }

    .reviews_card_avatar_svg {
      width: 1.125rem;
      aspect-ratio: 1 / 1;
      fill: none;
    }

    .reviews_card_avatar_path {
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .reviews_card_author_text_wrap {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }

    .reviews_card_name {
      font-weight: var(--_typography---font--primary-medium);
    }

    .reviews_card_location {
      color: color-mix(in hsl, currentColor 65%, transparent);
    }
  </style>

  <div class="reviews_contain u-container">
    <div class="reviews_content u-margin-trim u-alignment-center" data-reveal>
      <div class="reviews_eyebrow_wrap">
        <div class="reviews_eyebrow_dot" aria-hidden="true"></div>
        <div class="reviews_eyebrow_number u-text-style-small">{t.eyebrowNumber}</div>
        <div class="reviews_eyebrow_label u-text-style-small">{t.eyebrowLabel}</div>
      </div>
      <div class="reviews_title u-heading u-text-style-h2">
        <h2>{t.title}</h2>
      </div>
      <div class="reviews_text u-text u-text-style-main">
        <p>{t.text}</p>
      </div>
    </div>

    <div class="reviews_grid">
      {t.items.map((item, index) => (
        <div class="reviews_card_wrap" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <div class="reviews_card_stars_wrap" aria-hidden="true">
            {Array.from({ length: 5 }, () => (
              <svg class="reviews_card_star" viewBox="0 0 24 24">
                <path class="reviews_card_star_path" d="m12 4 2.5 5.5L20 10l-4.3 3.9L17 20l-5-3-5 3 1.3-6.1L4 10l5.5-.5Z" />
              </svg>
            ))}
          </div>
          <p class="reviews_card_quote u-text-style-small">{item.quote}</p>
          <div class="reviews_card_author_wrap">
            <div class="reviews_card_avatar_wrap" aria-hidden="true">
              <svg class="reviews_card_avatar_svg" viewBox="0 0 24 24">
                <path class="reviews_card_avatar_path" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                <path class="reviews_card_avatar_path" d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" />
              </svg>
            </div>
            <div class="reviews_card_author_text_wrap">
              <div class="reviews_card_name u-text-style-small">{item.name}</div>
              <div class="reviews_card_location u-text-style-small">{item.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
