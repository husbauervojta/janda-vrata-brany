---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const words = content[lang].marquee;
---

<div class="marquee_wrap u-theme-brand" aria-hidden="true">
  <style>
    .marquee_wrap {
      overflow: clip;
      padding-top: var(--_spacing---space--4);
      padding-bottom: var(--_spacing---space--4);
      background-color: var(--_theme---background);
      color: var(--_theme---text);
      border-top-style: solid;
      border-top-width: var(--border-width--main);
      border-bottom-style: solid;
      border-bottom-width: var(--border-width--main);
      border-color: var(--_theme---border);
    }

    .marquee_track {
      display: flex;
      width: fit-content;
    }

    @media (prefers-reduced-motion: no-preference) {
      .marquee_track {
        animation: marquee-scroll 24s linear infinite;
      }
    }

    @keyframes marquee-scroll {
      from {
        transform: translateX(-50%);
      }
      to {
        transform: translateX(0);
      }
    }

    .marquee_group {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--_spacing---space--5);
      padding-right: var(--_spacing---space--5);
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee_group:nth-child(2) {
        display: none;
      }
    }

    .marquee_word {
      flex-shrink: 0;
      white-space: nowrap;
      text-transform: uppercase;
      font-size: 1.125rem;
      font-weight: var(--_typography---font--primary-bold);
      letter-spacing: var(--_typography---letter-spacing--tight);
    }

    .marquee_dot {
      width: 0.375rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: var(--radius--round);
      background-color: currentColor;
    }
  </style>

  <div class="marquee_track">
    <div class="marquee_group">
      {words.map((word) => (
        <>
          <div class="marquee_word">{word}</div>
          <div class="marquee_dot"></div>
        </>
      ))}
    </div>
    <div class="marquee_group">
      {words.map((word) => (
        <>
          <div class="marquee_word">{word}</div>
          <div class="marquee_dot"></div>
        </>
      ))}
    </div>
  </div>
</div>
