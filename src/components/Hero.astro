---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="hero_wrap u-section u-theme-dark">
  <style>
    .hero_wrap {
      position: relative;
      overflow: clip;
      padding-top: var(--_spacing---section-space--page-top);
    }

    /* .hero_wrap sits above .hero_contain (the size query container), so
       it can't read the --_responsive---medium keyword vars — a plain
       media query is the only option for trimming its own padding. This
       is what keeps the house illustration inside the first mobile
       screen instead of needing a scroll to see it. */
    @media (max-width: 50em) {
      .hero_wrap {
        padding-top: 5rem;
      }
    }

    .hero_glow_wrap {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }

    .hero_glow_primary {
      position: absolute;
      top: -12rem;
      right: -10rem;
      width: 34rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius--round);
      background-color: var(--_theme---accent);
      opacity: 0.16;
      filter: blur(7rem);
    }

    .hero_glow_secondary {
      position: absolute;
      bottom: -16rem;
      left: -10rem;
      width: 28rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius--round);
      background-color: var(--_theme---accent);
      opacity: 0.08;
      filter: blur(8rem);
    }

    .hero_layout {
      display: var(--flex-medium, grid);
      flex-direction: column;
      align-items: var(--unset-medium, center);
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--_spacing---space--8);
    }

    .hero_content {
      grid-column: 1 / span 6;
      grid-row: 1;
      width: 100%;
      min-width: 0;
    }

    .hero_tag_wrap {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      gap: var(--_spacing---space--2);
      padding: var(--_spacing---space--2) var(--_spacing---space--4);
      margin-bottom: var(--_spacing---space--5);
      background-color: var(--_theme---background-2);
      color: var(--_theme---text);
      border-radius: var(--radius--round);
    }

    .hero_tag_svg {
      width: 1rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      fill: none;
    }

    .hero_tag_path {
      stroke: currentColor;
      stroke-width: var(--border-width--main);
    }

    .hero_tag_text {
      font-weight: var(--_typography---font--primary-medium);
    }

    .hero_title {
      display: flex;
      max-width: 17ch;
      margin-bottom: var(--_text-style---margin-bottom);
      font-size: 3rem;
      font-weight: var(--_typography---font--primary-extrabold);
      letter-spacing: var(--_typography---letter-spacing--tight);
    }

    @container (width < 50em) {
      .hero_title {
        font-size: 2.25rem;
      }
    }

    .hero_title_line {
      display: block;
    }

    /* Second line reads as a subtitle, not a second headline — sized off
       the (already responsive) parent font-size so it shrinks with it. */
    .hero_title_line_sub {
      font-size: 0.55em;
      font-weight: var(--_typography---font--primary-medium);
    }

    .hero_text {
      display: flex;
      max-width: 42ch;
      margin-bottom: var(--_text-style---margin-bottom);
      color: color-mix(in hsl, currentColor 80%, transparent);
    }

    .hero_actions {
      margin-bottom: var(--_spacing---space--6);
    }

    .hero_button_wrap,
    .hero_button_secondary_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      white-space: nowrap;
      padding: var(--_spacing---space--3) var(--_spacing---space--5);
      border-radius: var(--radius--small);
      border-style: solid;
      border-width: var(--border-width--main);
      font-weight: var(--_typography---font--primary-medium);
      transform: translateY(calc(-0.125rem * var(--_trigger---on)));
      transition: all 300ms;
    }

    .hero_button_wrap {
      background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
      color: color-mix(in hsl, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
      border-color: color-mix(in hsl, var(--_theme---button-primary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--border-hover) calc(100% * var(--_trigger---off)));
      box-shadow: 0 0 calc(1.25rem + 1rem * var(--_trigger---on)) var(--_theme---accent-glow);
    }

    .hero_button_secondary_wrap {
      background-color: color-mix(in hsl, var(--_theme---button-secondary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--background-hover) calc(100% * var(--_trigger---off)));
      color: color-mix(in hsl, var(--_theme---button-secondary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--text-hover) calc(100% * var(--_trigger---off)));
      border-color: color-mix(in hsl, var(--_theme---button-secondary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--border-hover) calc(100% * var(--_trigger---off)));
    }

    /* Both CTAs stay on one row on mobile instead of stacking full-width —
       shrinking padding/font is enough since the labels are short. */
    @container (width < 50em) {
      .hero_button_wrap,
      .hero_button_secondary_wrap {
        flex: 1 1 0;
        width: auto;
        min-width: 0;
        padding: var(--_spacing---space--2) var(--_spacing---space--3);
        font-size: 0.8125rem;
      }
    }

    .hero_list_wrap {
      grid-column: 1 / span 6;
      grid-row: 2;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: var(--_spacing---space--2);
    }

    .hero_list_item {
      padding: var(--_spacing---space--2) var(--_spacing---space--4);
      background-color: var(--_theme---background-2);
      color: var(--_theme---text);
      border-radius: var(--radius--round);
    }

    .hero_visual_wrap {
      grid-column: 7 / span 6;
      grid-row: 1 / span 2;
      width: 100%;
      min-width: 0;
      /* aspect-ratio lives here, container-type lives one level down on
         .hero_visual_cq — combining both on the same element collapses to
         zero height on some mobile WebKit versions, since the only children
         are position: absolute and can't imply a fallback height. */
      position: relative;
      aspect-ratio: 3 / 2;
    }

    .hero_visual_cq {
      container-type: inline-size;
      position: absolute;
      inset: 0;
    }

    .hero_visual_inner {
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      font-size: 1cqw;
    }

    .hero_house_svg {
      width: 96em;
      aspect-ratio: 360 / 172;
      overflow: visible;
    }

    /* Technical-drawing look: thin, quiet stroke at rest. */
    .hero_draw {
      fill: none;
      stroke: var(--_theme---border);
      stroke-width: 0.14em;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Tahy skicy mají tloušťku v jednotkách viewBoxu, ne v em — jinak by se
       při každé změně kontejneru rozjela vůči kresbě. Vyšší specificita
       než .hero_draw, aby to přebilo řádek výš. */
    .hero_house_svg .hero_sketch {
      stroke: var(--_theme---text);
      /* Tloušťka v jednotkách viewBoxu. Žádný non-scaling-stroke — ten by
         z ní udělal desetiny CSS pixelu a kresba by zmizela. */
      stroke-width: calc(var(--sw, 0.5) * 2.4);
    }

    .hero_garage_door {
      /* Explicit view-box coordinates (garage top-center), not fill-box —
         transform-box: fill-box on a multi-child <g> is unreliable across
         browsers and can make the whole group jump off-position. */
      transform-origin: 212.0px 97.8px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero_garage_door {
        animation: hero-door-cycle 8s ease-in-out infinite;
        /* Až po dokreslení, jinak se vrata otevřou dřív, než vzniknou. */
        animation-delay: 2.8s;
      }
    }

    @keyframes hero-door-cycle {
      0%,
      15% {
        transform: scaleY(1);
      }
      40%,
      60% {
        transform: scaleY(0.1);
      }
      85%,
      100% {
        transform: scaleY(1);
      }
    }

    .hero_garage_door_panel {
      fill: var(--_theme---accent);
    }

    .hero_gate {
      /* translateX doesn't depend on transform-origin, so no fill-box needed. */
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero_gate {
        animation: hero-gate-cycle 10s ease-in-out infinite;
        animation-delay: 3.6s;
      }
    }

    @keyframes hero-gate-cycle {
      0%,
      15% {
        transform: translateX(0);
      }
      40%,
      60% {
        transform: translateX(16%);
      }
      85%,
      100% {
        transform: translateX(0);
      }
    }

    .hero_gate_panel {
      fill: var(--_theme---accent);
    }

    .hero_callout_wrap {
      display: flex;
      flex-direction: column;
      position: absolute;
      width: 11em;
      font-size: 1.3em;
      padding: 0.9em 1em;
      background-color: var(--_theme---background);
      color: var(--_theme---text);
      border-radius: 0.9em;
      border-style: solid;
      border-width: var(--border-width--main);
      border-color: color-mix(in hsl, var(--_theme---border) calc(100% * var(--_trigger---off)), var(--_theme---accent) calc(100% * var(--_trigger---on)));
      transition: all 300ms;
    }

    .hero_callout_wrap.is-accent {
      background-color: var(--_theme---accent);
      color: var(--_theme---accent-text);
      border-color: var(--_theme---accent);
      box-shadow: 0 0 calc(1.5em * var(--_trigger---on)) var(--_theme---accent-glow);
    }

    .hero_callout_corner_svg {
      width: 0.9em;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      margin-bottom: 0.5em;
      fill: none;
    }

    .hero_callout_corner_path {
      stroke: currentColor;
      stroke-width: 0.15em;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hero_callout_text {
      font-weight: var(--_typography---font--primary-medium);
    }

    .hero_callout_1 {
      top: 0;
      left: 52%;
      transform: translateY(2.5em);
    }

    .hero_callout_2 {
      top: 0;
      right: 0;
      transform: translateX(1.5em) translateY(9em);
    }

    .hero_callout_3 {
      top: 0;
      left: 0;
      transform: translateX(-1.5em) translateY(1em);
    }

    .hero_visual_status_wrap {
      display: flex;
      align-items: center;
      gap: 0.5em;
      position: absolute;
      bottom: 0;
      left: 0;
      transform: translateX(-1em) translateY(-1em);
      font-size: 1.4em;
      padding: 0.5em 0.9em;
      background-color: var(--_theme---background);
      color: var(--_theme---text);
      border-radius: 2em;
      border-style: solid;
      border-width: var(--border-width--main);
      border-color: var(--_theme---border);
    }

    .hero_status_dot_wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 0.55em;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      color: var(--_theme---accent);
    }

    .hero_status_pulse {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 2em;
      background-color: currentColor;
      opacity: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero_status_pulse {
        animation: hero-status-pulse 2s ease-out infinite;
      }
    }

    @keyframes hero-status-pulse {
      0% {
        transform: scale(1);
        opacity: 0.6;
      }
      100% {
        transform: scale(2.4);
        opacity: 0;
      }
    }

    .hero_status_dot {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 2em;
      background-color: currentColor;
    }

    .hero_status_text {
      font-size: 0.75em;
      font-weight: var(--_typography---font--primary-medium);
    }

    /* ---------------------------------------------------------------
       Dům se nakreslí sám.

       stroke-dasharray funguje i na <line>, <rect> a <circle>, ne jen na
       <path>, takže kresbu nebylo potřeba nijak převádět. pathLength="1"
       normalizuje délku každého tvaru na jedničku, takže jedno pravidlo
       obslouží všechny tahy naráz a nepotřebuje to žádný JavaScript.

       Všechno visí uvnitř prefers-reduced-motion: no-preference — kdo má
       omezené animace, uvidí rovnou hotovou kresbu, ne prázdné plátno.
       --------------------------------------------------------------- */
    @keyframes hero-draw-on {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes hero-fade-in {
      to {
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero_house_svg .hero_draw {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: hero-draw-on 640ms ease-out forwards;
        animation-delay: var(--d, 0ms);
      }

      /* Vyplněné panely se dash trikem nakreslit nedají, ty naběhnou krytím. */
      .hero_garage_door_panel,
      .hero_gate_panel {
        opacity: 0;
        animation: hero-fade-in 420ms ease-out forwards;
        animation-delay: var(--d, 0ms);
      }

      .hero_callout_wrap,
      .hero_visual_status_wrap {
        opacity: 0;
        animation: hero-fade-in 380ms ease-out forwards;
        animation-delay: calc(2200ms + var(--i, 0) * 130ms);
      }
    }
  </style>

  <div class="hero_glow_wrap" aria-hidden="true">
    <div class="hero_glow_primary"></div>
    <div class="hero_glow_secondary"></div>
  </div>

  <div class="hero_contain u-container">
    <div class="hero_layout">
      <div class="hero_content u-margin-trim">
        <div class="hero_tag_wrap">
          <svg class="hero_tag_svg" viewBox="0 0 24 24" aria-hidden="true">
            <path class="hero_tag_path" d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
            <path class="hero_tag_path" d="M12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
          </svg>
          <div class="hero_tag_text u-text-style-small">{t.tag}</div>
        </div>

        <div class="hero_title u-heading u-text-style-h1">
          <h1><span class="hero_title_line">{t.titleLine1}</span><span class="hero_title_line hero_title_line_sub">{t.titleLine2}</span></h1>
        </div>

        <div class="hero_text u-text u-text-style-large">
          <p>{t.text}</p>
        </div>

        <div class="hero_actions u-button-wrapper">
          <a class="hero_button_wrap" data-trigger="hover focus" href="#quote">
            {t.ctaPrimary}
          </a>
          <a class="hero_button_secondary_wrap" data-trigger="hover focus" href="#services">
            {t.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="hero_visual_wrap">
       <div class="hero_visual_cq">
        <div class="hero_visual_inner">
          <svg class="hero_house_svg" viewBox="0 24 360 172" aria-hidden="true">
            <!-- Perspektivní skica od nároží. Každá hrana je vedená dvakrát až
                 třikrát přes sebe s přetahy za rohy, takže to nevypadá jako
                 výkres z CADu, ale jako skica tužkou. Kresba se rýsuje po fázích. -->

            <g style="--d: 0ms">
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.95" style="--sw: 0.58" d="M3.0 162.0 C5.8 162.2 14.4 162.9 20.1 163.2 C25.8 163.5 31.5 163.7 37.2 163.8 C42.9 164.0 48.7 164.0 54.4 164.2 C60.1 164.4 65.8 164.7 71.5 165.1 C77.2 165.6 82.9 166.2 88.6 166.7 C94.2 167.2 99.9 167.7 105.6 168.2 C111.3 168.7 117.0 169.1 122.7 169.7 C128.4 170.4 136.9 171.7 139.7 172.1"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.65" style="--sw: 0.44" d="M2.2 162.0 C5.1 162.2 13.7 163.0 19.5 163.4 C25.2 163.8 31.0 164.1 36.8 164.3 C42.5 164.4 48.4 164.0 54.1 164.3 C59.9 164.7 65.6 166.1 71.3 166.6 C77.1 167.2 82.9 167.4 88.6 167.7 C94.4 168.0 100.2 168.1 106.0 168.5 C111.7 168.8 117.5 169.2 123.2 169.8 C129.0 170.5 137.6 171.8 140.4 172.2"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.95" style="--sw: 0.58" d="M134.8 172.2 C137.6 172.0 146.2 171.3 151.9 170.9 C157.7 170.4 163.4 169.9 169.1 169.4 C174.8 168.9 180.5 168.5 186.3 168.1 C192.0 167.6 197.7 167.1 203.4 166.8 C209.2 166.6 214.9 166.8 220.6 166.4 C226.4 165.9 232.1 164.9 237.8 164.2 C243.5 163.5 249.1 162.4 254.9 162.0 C260.6 161.7 266.4 162.4 272.1 162.1 C277.9 161.8 283.5 160.6 289.3 160.3 C295.0 160.0 300.8 160.2 306.5 160.2 C312.2 160.1 318.0 160.1 323.7 159.9 C329.5 159.7 335.2 159.1 340.9 158.9 C346.7 158.7 355.3 158.7 358.1 158.6"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.65" style="--sw: 0.44" d="M136.7 172.1 C139.5 171.9 148.1 171.3 153.8 170.9 C159.5 170.5 165.2 170.3 170.9 169.9 C176.6 169.4 182.3 168.9 188.0 168.3 C193.7 167.7 199.3 166.8 205.0 166.3 C210.7 165.7 216.4 165.7 222.1 165.0 C227.8 164.3 233.4 162.9 239.1 162.1 C244.8 161.4 250.5 161.0 256.2 160.4 C261.9 159.7 267.5 158.7 273.3 158.3 C279.0 158.0 284.7 158.4 290.4 158.4 C296.2 158.3 301.9 157.8 307.6 157.8 C313.3 157.8 319.1 158.2 324.8 158.2 C330.5 158.3 336.2 158.1 342.0 158.2 C347.7 158.3 356.3 158.5 359.2 158.6"/>
            </g>

            <g style="--d: 220ms">
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.95" style="--sw: 0.67" d="M138.0 48.1 C138.0 51.1 138.0 60.0 138.1 66.0 C138.2 72.0 138.5 77.9 138.5 83.9 C138.6 89.9 138.5 95.9 138.5 101.8 C138.6 107.8 138.8 113.8 138.8 119.7 C138.8 125.7 138.8 131.7 138.7 137.6 C138.7 143.6 138.6 149.6 138.5 155.5 C138.4 161.5 138.1 170.5 138.0 173.4"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.65" style="--sw: 0.51" d="M138.0 47.4 C138.0 50.4 138.1 59.3 138.1 65.3 C138.0 71.3 137.9 77.2 137.7 83.2 C137.5 89.2 137.1 95.1 137.0 101.1 C137.0 107.1 137.4 113.0 137.4 119.0 C137.4 125.0 137.1 130.9 137.1 136.9 C137.2 142.9 137.5 148.8 137.6 154.8 C137.8 160.7 137.9 169.7 138.0 172.7"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.45" style="--sw: 0.83" d="M138.0 49.3 C138.0 52.3 138.0 61.1 138.0 67.0 C138.0 72.9 138.2 78.8 138.2 84.7 C138.2 90.6 138.0 96.6 138.0 102.5 C138.0 108.4 138.1 114.3 138.1 120.2 C138.1 126.1 137.9 132.0 137.9 137.9 C137.8 143.8 138.0 149.7 138.0 155.6 C138.0 161.5 138.0 170.4 138.0 173.3"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.95" style="--sw: 0.58" d="M32.0 64.9 C35.0 64.5 43.9 63.1 49.8 62.2 C55.8 61.3 61.7 60.3 67.7 59.3 C73.6 58.4 79.6 57.5 85.5 56.6 C91.5 55.8 97.4 54.8 103.4 54.0 C109.4 53.3 115.4 52.7 121.4 52.0 C127.3 51.3 136.3 50.2 139.3 49.8"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.65" style="--sw: 0.44" d="M33.4 64.7 C36.3 64.2 45.1 62.6 50.9 61.6 C56.7 60.5 62.6 59.5 68.5 58.6 C74.3 57.8 80.2 57.1 86.1 56.4 C92.0 55.6 97.9 54.8 103.8 54.1 C109.7 53.4 115.6 53.0 121.5 52.2 C127.4 51.5 136.2 50.2 139.1 49.8"/>
              <path class="hero_draw hero_sketch" pathLength="1" opacity="0.95" style="--sw: 0.58" d="M32.1 164.2 C35.0 164.4 44.0 165.2 50.0 165.8 C55.9 166.4 61.9 167.0 67.8 167.6 C73.8 168.2 79.8 168.9 85.7 169.4 C91.7 169.9 97.7 170.3 103.7 170.6 C109.6 170.9 115.6 171.0 121.6 171.3 C127.6 171.5 136.6 172.0 139.6 172.1"/>
