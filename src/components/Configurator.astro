---
import "../styles/tailwind.css";
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].configurator;

const produktIcons: Record<string, string> = {
  "garazova-vrata": "M4 11 12 4l8 7 M6 10v10h12V10",
  "zahradni-vrata": "M4 20h16 M7 20V8l5-3 5 3v12 M9 20v-6h6v6",
};

const typPaths = [
  "M4 11 12 4l8 7 M6 10v10h12V10",
  "M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 1 5.4-5.4L14.7 12l-2.7-2.7Z",
];

const pohonPaths = [
  "M12 4v3M12 17v3M4 12h3M17 12h3M6.3 6.3l2.1 2.1M15.6 15.6l2.1 2.1M6.3 17.7l2.1-2.1M15.6 8.4l2.1-2.1 M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  "M7 12h10 M7 12l3-3 M7 12l3 3",
  "M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.7 M12 17h.01",
];

const stepLabels = t.steps;
const produktOptions = t.produktOptions.map((option) => ({ ...option, path: produktIcons[option.id] }));
const typOptions = t.typOptions.map((option, index) => ({ ...option, path: typPaths[index] }));
const pohonOptions = t.pohonOptions.map((option, index) => ({ ...option, path: pohonPaths[index] }));
---

<section
  id="quote"
  class="configurator_wrap u-section u-theme-dark"
  data-summary-labels={JSON.stringify(t.summaryLabels)}
  data-produkt-options={JSON.stringify(produktOptions)}
>
  <style>
    .configurator_content {
      max-width: var(--max-width--small);
      margin-left: auto;
      margin-right: auto;
      margin-bottom: var(--_spacing---space--8);
    }

    .configurator_title {
      max-width: 20ch;
      margin-bottom: var(--_text-style---margin-bottom);
    }

    .configurator_text {
      max-width: 42ch;
      color: color-mix(in hsl, currentColor 75%, transparent);
    }

    .configurator_eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      gap: var(--_spacing---space--2);
      margin-bottom: var(--_spacing---space--4);
    }

    .configurator_eyebrow_dot {
      width: 0.4rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: var(--radius--round);
      background-color: var(--_theme---accent);
    }

    .configurator_eyebrow_number {
      color: var(--_theme---accent);
      font-weight: var(--_typography---font--primary-bold);
    }

    .configurator_eyebrow_label {
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: color-mix(in hsl, currentColor 65%, transparent);
    }

    .configurator_layout {
      display: var(--flex-medium, grid);
      flex-direction: column-reverse;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: var(--_spacing---space--8);
    }

    .configurator_panel_wrap {
      grid-column: 1 / span 6;
      width: 100%;
      padding: var(--_spacing---space--6);
      background-color: var(--_theme---background-2);
      border-radius: var(--radius--main);
    }

    .configurator_steps_wrap {
      display: flex;
      align-items: center;
      margin-bottom: var(--_spacing---space--6);
    }

    .configurator_step_item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--_spacing---space--2);
      width: 100%;
    }

    .configurator_step_number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius--round);
      background-color: var(--_theme---background);
      color: var(--_theme---text);
      border-style: solid;
      border-width: var(--border-width--main);
      border-color: var(--_theme---border);
      font-weight: var(--_typography---font--primary-medium);
      transition: all 300ms;
    }

    .configurator_step_item.is-active .configurator_step_number {
      background-color: var(--_theme---accent);
      color: var(--_theme---accent-text);
      border-color: var(--_theme---accent);
    }

    .configurator_step_label {
      color: color-mix(in hsl, currentColor 70%, transparent);
    }

    .configurator_step_item.is-active .configurator_step_label {
      color: var(--_theme---text);
      font-weight: var(--_typography---font--primary-medium);
    }

    .configurator_steps_track {
      position: relative;
      height: var(--border-width--main);
      width: 100%;
      max-width: 6rem;
      margin-top: -1.5rem;
      background-color: var(--_theme---border);
    }

    .configurator_steps_fill {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: calc((var(--configurator-progress, 1) - 1) / 3 * 100%);
      background-color: var(--_theme---accent);
      transition: width 400ms ease;
    }

    .configurator_panel {
      display: none;
      flex-direction: column;
      border: none;
      padding: 0;
      margin: 0;
    }

    .configurator_panel.is-active {
      display: flex;
    }

    .configurator_panel_title {
      margin-bottom: var(--_spacing---space--4);
      padding: 0;
    }

    .configurator_options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--_spacing---space--3);
      margin-bottom: var(--_spacing---space--6);
    }

    [data-options="pohon"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    [data-options="produkt"] {
      margin-bottom: 0;
    }

    @container (width < 35em) {
      .configurator_options {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }

    .configurator_option_wrap {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: var(--_spacing---space--4);
      background-color: var(--_theme---background);
      border-radius: var(--radius--small);
      border-style: solid;
      border-width: var(--border-width--main);
      border-color: var(--_theme---border);
      text-align: left;
      cursor: pointer;
      transition: all 300ms;
    }

    .configurator_option_wrap.is-active {
      border-color: var(--_theme---accent);
      box-shadow: 0 0 0 var(--border-width--main) var(--_theme---accent);
    }

    .configurator_option_produkt_wrap {
      flex-direction: row;
      align-items: center;
      gap: var(--_spacing---space--3);
    }

    .configurator_option_icon_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: var(--radius--small);
      background-color: var(--_theme---background-2);
      color: var(--_theme---text);
      transition: all 300ms;
    }

    .configurator_option_produkt_wrap.is-active .configurator_option_icon_wrap {
      background-color: var(--_theme---accent);
      color: var(--_theme---accent-text);
    }

    .configurator_option_icon_wrap .configurator_option_svg {
      width: 1.375rem;
      margin-bottom: 0;
    }

    .configurator_option_text_wrap {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }

    .configurator_option_svg {
      width: 1.75rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      margin-bottom: var(--_spacing---space--3);
      fill: none;
    }

    .configurator_option_path {
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .configurator_option_wrap.is-active .configurator_option_svg {
      color: var(--_theme---accent);
    }

    .configurator_option_title {
      margin-bottom: var(--_spacing---space--1);
      font-weight: var(--_typography---font--primary-medium);
    }

    .configurator_option_produkt_wrap .configurator_option_title {
      margin-bottom: 0;
    }

    .configurator_option_text {
      color: color-mix(in hsl, currentColor 70%, transparent);
    }

    .configurator_summary_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--_spacing---space--2);
      margin-bottom: var(--_spacing---space--6);
    }

    .configurator_summary_item {
      padding: var(--_spacing---space--3) var(--_spacing---space--4);
      background-color: var(--_theme---background);
      border-radius: var(--radius--small);
    }

    .configurator_summary_value {
      font-weight: var(--_typography---font--primary-medium);
    }

    .configurator_next_wrap,
    .configurator_back_wrap,
    .configurator_submit_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      white-space: nowrap;
      padding: var(--_spacing---space--3) var(--_spacing---space--5);
      border-radius: var(--radius--small);
      border-style: solid;
      border-width: var(--border-width--main);
      font-weight: var(--_typography---font--primary-medium);
      transform: translateY(calc(-0.125rem * var(--_trigger---on)));
      transition: all 300ms;
    }

    .configurator_next_wrap,
    .configurator_submit_wrap {
      background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
      color: color-mix(in hsl, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
      border-color: color-mix(in hsl, var(--_theme---button-primary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--border-hover) calc(100% * var(--_trigger---off)));
    }

    .configurator_next_wrap:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
    }

    .configurator_back_wrap {
      background-color: color-mix(in hsl, var(--_theme---button-secondary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--background-hover) calc(100% * var(--_trigger---off)));
      color: color-mix(in hsl, var(--_theme---button-secondary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--text-hover) calc(100% * var(--_trigger---off)));
      border-color: color-mix(in hsl, var(--_theme---button-secondary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--border-hover) calc(100% * var(--_trigger---off)));
    }

    .configurator_visual_wrap {
      grid-column: 7 / span 6;
      width: 100%;
      container-type: inline-size;
      position: relative;
      aspect-ratio: 3 / 2;
    }

    .configurator_visual_inner {
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      font-size: 1cqw;
    }

    .configurator_house_svg {
      width: 88em;
      aspect-ratio: 320 / 190;
      overflow: visible;
    }

    /* Minimalist line-art: every structural stroke shares this look and is
       drawn on with GSAP (stroke-dasharray/dashoffset) once it scrolls into
       view — see the [data-draw] handling in the script below. */
    .configurator_draw {
      fill: none;
      stroke: var(--_theme---text);
      stroke-width: 0.14em;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: opacity 300ms;
    }

    /* Once any product is picked, the rest of the sketch quiets down so the
       active target is the only thing that pops. */
    .configurator_house_svg.has-active .configurator_draw {
      opacity: 0.3;
    }

    .configurator_house_svg.has-active .configurator_target.is-active .configurator_draw {
      opacity: 1;
    }

    /* The two clickable-from-the-menu targets: neutral outline by default,
       fill smoothly to accent + glow + pulse when picked in step 1. */
    .configurator_target {
      transition: filter 300ms;
    }

    .configurator_target_panel {
      fill: transparent;
      transition: fill 400ms ease;
    }

    /* Sectional/gate seam lines: drawn in the section background color so
       they read as gaps once the panel behind them fills with accent. */
    .configurator_target_seam {
      fill: none;
      stroke: var(--_theme---background);
      stroke-width: 0.1em;
      stroke-linecap: round;
    }

    .configurator_target.is-active .configurator_target_panel {
      fill: var(--_theme---accent);
    }

    .configurator_target.is-active {
      filter: drop-shadow(0 0 0.6em var(--_theme---accent-glow));
    }

    @media (prefers-reduced-motion: no-preference) {
      .configurator_target.is-active {
        animation: configurator-target-pulse 1.6s ease-in-out infinite;
      }
    }

    @keyframes configurator-target-pulse {
      0%,
      100% {
        filter: drop-shadow(0 0 0.6em var(--_theme---accent-glow));
      }
      50% {
        filter: drop-shadow(0 0 1.1em var(--_theme---accent-glow));
      }
    }

    /* Detail card: fades/slides in beside the house once a product is
       picked (see showDetail() in the script; animates via the Tailwind
       transition-all class already on this element). */
    .configurator_detail_wrap {
      background-color: var(--_theme---background);
      color: var(--_theme---text);
      border: var(--border-width--main) solid var(--_theme---border);
      opacity: 0;
      transform: translateY(0.75rem);
      pointer-events: none;
    }

    .configurator_detail_icon_wrap {
      background-color: var(--_theme---accent);
      color: var(--_theme---accent-text);
    }

    .configurator_detail_svg {
      fill: none;
    }

    .configurator_detail_path {
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .configurator_detail_text {
      color: color-mix(in hsl, currentColor 70%, transparent);
    }

    .configurator_detail_cta {
      background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
      color: color-mix(in hsl, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
      box-shadow: 0 0 calc(0.75rem + 0.75rem * var(--_trigger---on)) var(--_theme---accent-glow);
    }

    @container (width < 50em) {
      .configurator_panel_wrap,
      .configurator_visual_wrap {
        grid-column: 1 / span 12;
      }
    }
  </style>

  <div class="configurator_contain u-container">
    <div class="configurator_content u-margin-trim u-alignment-center" data-reveal>
      <div class="configurator_eyebrow_wrap">
        <div class="configurator_eyebrow_dot" aria-hidden="true"></div>
        <div class="configurator_eyebrow_number u-text-style-small">{t.eyebrowNumber}</div>
        <div class="configurator_eyebrow_label u-text-style-small">{t.eyebrowLabel}</div>
      </div>
      <div class="configurator_title u-heading u-text-style-h2">
        <h2>{t.title}</h2>
      </div>
      <div class="configurator_text u-text u-text-style-main">
        <p>{t.text}</p>
      </div>
    </div>

    <div class="configurator_layout" data-reveal>
      <div class="configurator_panel_wrap" style="--configurator-progress: 1;">
        <div class="configurator_steps_wrap">
          {stepLabels.map((label, index) => (
            <div class="configurator_step_item" class:list={{ "is-active": index === 0 }} data-step-indicator={index + 1}>
              <div class="configurator_step_number">{index + 1}</div>
              <div class="configurator_step_label u-text-style-small">{label}</div>
            </div>
          ))}
        </div>
        <div class="configurator_steps_track">
          <div class="configurator_steps_fill"></div>
        </div>

        <form class="configurator_form_wrap">
          <fieldset class="configurator_panel is-active" data-step-panel="1">
            <legend class="configurator_panel_title u-text-style-h5">{t.panelTitles[0]}</legend>
            <div class="configurator_options" data-options="produkt">
              {produktOptions.map((option) => (
                <button
                  type="button"
                  class="configurator_option_wrap configurator_option_produkt_wrap"
                  data-option-group="produkt"
                  data-option-value={option.value}
                  data-target={option.id}
                  data-trigger="hover focus"
                  aria-pressed="false"
                >
                  <div class="configurator_option_icon_wrap">
                    <svg class="configurator_option_svg" viewBox="0 0 24 24" aria-hidden="true">
                      <path class="configurator_option_path" d={option.path} />
                    </svg>
                  </div>
                  <div class="configurator_option_text_wrap">
                    <div class="configurator_option_title u-text-style-main">{option.value}</div>
                    <div class="configurator_option_text u-text-style-small">{option.text}</div>
                  </div>
                </button>
              ))}
            </div>
            <div class="configurator_actions u-button-wrapper">
              <button class="configurator_next_wrap" type="button" data-trigger="hover focus" data-action="next" disabled>
                {t.buttons.next}
              </button>
            </div>
          </fieldset>

          <fieldset class="configurator_panel" data-step-panel="2">
            <legend class="configurator_panel_title u-text-style-h5">{t.panelTitles[1]}</legend>
            <div class="configurator_options" data-options="typ">
              {typOptions.map((option) => (
                <button
                  type="button"
                  class="configurator_option_wrap"
                  data-option-group="typ"
                  data-option-value={option.value}
                  data-trigger="hover focus"
                  aria-pressed="false"
                >
                  <svg class="configurator_option_svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path class="configurator_option_path" d={option.path} />
                  </svg>
                  <div class="configurator_option_title u-text-style-main">{option.value}</div>
                  <div class="configurator_option_text u-text-style-small">{option.text}</div>
                </button>
              ))}
            </div>
            <div class="configurator_actions u-button-wrapper">
              <button class="configurator_back_wrap" type="button" data-trigger="hover focus" data-action="back">
                {t.buttons.back}
              </button>
              <button class="configurator_next_wrap" type="button" data-trigger="hover focus" data-action="next" disabled>
                {t.buttons.next}
              </button>
            </div>
          </fieldset>

          <fieldset class="configurator_panel" data-step-panel="3">
            <legend class="configurator_panel_title u-text-style-h5">{t.panelTitles[2]}</legend>
            <div class="configurator_options" data-options="pohon">
              {pohonOptions.map((option) => (
                <button
                  type="button"
                  class="configurator_option_wrap"
                  data-option-group="pohon"
                  data-option-value={option.value}
                  data-trigger="hover focus"
                  aria-pressed="false"
                >
                  <svg class="configurator_option_svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path class="configurator_option_path" d={option.path} />
                  </svg>
                  <div class="configurator_option_title u-text-style-main">{option.value}</div>
                  <div class="configurator_option_text u-text-style-small">{option.text}</div>
                </button>
              ))}
            </div>
            <div class="configurator_actions u-button-wrapper">
              <button class="configurator_back_wrap" type="button" data-trigger="hover focus" data-action="back">
                {t.buttons.back}
              </button>
              <button class="configurator_next_wrap" type="button" data-trigger="hover focus" data-action="next" disabled>
                {t.buttons.next}
              </button>
            </div>
          </fieldset>

          <div class="configurator_panel" data-step-panel="4">
            <div class="configurator_panel_title u-text-style-h5">{t.panelTitles[3]}</div>
            <ul class="configurator_summary_wrap">
              <li class="configurator_summary_item u-text-style-main">
                {t.summaryLabels.produkt}: <span class="configurator_summary_value" data-summary="produkt"></span>
              </li>
              <li class="configurator_summary_item u-text-style-main">
                {t.summaryLabels.typ}: <span class="configurator_summary_value" data-summary="typ"></span>
              </li>
              <li class="configurator_summary_item u-text-style-main">
                {t.summaryLabels.pohon}: <span class="configurator_summary_value" data-summary="pohon"></span>
              </li>
            </ul>
            <div class="configurator_actions u-button-wrapper">
              <button class="configurator_back_wrap" type="button" data-trigger="hover focus" data-action="back">
                {t.buttons.back}
              </button>
              <a class="configurator_submit_wrap" data-trigger="hover focus" href="#contact" data-action="goto-contact">
                {t.buttons.submit}
              </a>
            </div>
          </div>
        </form>
      </div>

      <div class="configurator_visual_wrap">
        <div class="configurator_visual_inner">
          <svg class="configurator_house_svg" viewBox="0 0 320 190" role="img" aria-label={t.panelTitles[0]}>
            <line class="configurator_draw" data-draw x1="8" y1="164" x2="312" y2="164" />

            <circle class="configurator_draw" data-draw cx="30" cy="150" r="11" />
            <circle class="configurator_draw" data-draw cx="20" cy="155" r="8" />
            <circle class="configurator_draw" data-draw cx="41" cy="156" r="8" />
            <circle class="configurator_draw" data-draw cx="292" cy="150" r="10" />
            <circle class="configurator_draw" data-draw cx="283" cy="156" r="7" />

            <line class="configurator_draw" data-draw x1="12" y1="152" x2="106" y2="152" />
            <line class="configurator_draw" data-draw x1="12" y1="163" x2="106" y2="163" />
            {Array.from({ length: 10 }, (_, i) => (
              <line class="configurator_draw" data-draw x1={14 + i * 10} y1="152" x2={14 + i * 10} y2="164" />
            ))}
            <line class="configurator_draw" data-draw x1="214" y1="152" x2="308" y2="152" />
            <line class="configurator_draw" data-draw x1="214" y1="163" x2="308" y2="163" />
            {Array.from({ length: 10 }, (_, i) => (
              <line class="configurator_draw" data-draw x1={216 + i * 10} y1="152" x2={216 + i * 10} y2="164" />
            ))}

            <rect class="configurator_draw" data-draw x="45" y="58" width="230" height="8" />
            <rect class="configurator_draw" data-draw x="215" y="34" width="14" height="24" />
            <rect class="configurator_draw" data-draw x="60" y="66" width="200" height="98" />

            <rect class="configurator_draw" data-draw x="80" y="86" width="26" height="26" />
            <line class="configurator_draw" data-draw x1="93" y1="86" x2="93" y2="112" />
            <line class="configurator_draw" data-draw x1="80" y1="99" x2="106" y2="99" />

            <rect class="configurator_draw" data-draw x="118" y="86" width="26" height="26" />
            <line class="configurator_draw" data-draw x1="131" y1="86" x2="131" y2="112" />
            <line class="configurator_draw" data-draw x1="118" y1="99" x2="144" y2="99" />

            <rect class="configurator_draw" data-draw x="96" y="128" width="22" height="36" />
            <circle class="configurator_draw" data-draw cx="113" cy="147" r="1.4" />

            <g id="zahradni-vrata" class="configurator_target">
              <rect class="configurator_draw" data-draw x="108" y="140" width="3" height="24" />
              <rect class="configurator_draw" data-draw x="209" y="140" width="3" height="24" />
              <rect class="configurator_draw" data-draw x="111" y="145" width="98" height="15" />
              <rect class="configurator_target_panel" x="112" y="146" width="96" height="13" />
              <line class="configurator_target_seam" data-draw x1="160" y1="145" x2="160" y2="160" />
              <line class="configurator_target_seam" data-draw x1="120" y1="160" x2="150" y2="145" />
              <line class="configurator_target_seam" data-draw x1="170" y1="145" x2="200" y2="160" />
            </g>

            <g id="garazova-vrata" class="configurator_target">
              <rect class="configurator_draw" data-draw x="190" y="96" width="64" height="68" />
              <rect class="configurator_target_panel" x="191" y="97" width="62" height="66" />
              <line class="configurator_target_seam" data-draw x1="191" y1="113" x2="253" y2="113" />
              <line class="configurator_target_seam" data-draw x1="191" y1="130" x2="253" y2="130" />
              <line class="configurator_target_seam" data-draw x1="191" y1="147" x2="253" y2="147" />
            </g>
          </svg>

          <div
            class="configurator_detail_wrap absolute bottom-4 left-4 right-4 flex flex-col gap-3 rounded-xl p-4 transition-all duration-300"
            data-detail-card
          >
            <div class="flex items-center gap-4">
              <div class="configurator_detail_icon_wrap flex h-11 w-11 shrink-0 items-center justify-center rounded-lg">
                <svg class="configurator_detail_svg h-6 w-6" viewBox="0 0 24 24" aria-hidden="true">
                  <path class="configurator_detail_path" data-detail-icon-path d="" />
                </svg>
              </div>
              <div class="flex min-w-0 flex-col gap-0.5">
                <div class="configurator_detail_title font-medium" data-detail-title></div>
                <div class="configurator_detail_text text-sm" data-detail-text></div>
              </div>
            </div>
            <a
              class="configurator_detail_cta inline-flex w-fit items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium transition-all duration-300"
              href="#contact"
              data-trigger="hover focus"
            >
              {t.detailCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll(".configurator_wrap").forEach((component) => {
        if (!(component instanceof HTMLElement)) return;
        if (component.dataset.scriptInitialized) return;
        component.dataset.scriptInitialized = "true";

        const summaryLabels = JSON.parse(component.dataset.summaryLabels ?? "{}");
        const produktOptions = JSON.parse(component.dataset.produktOptions ?? "[]");

        const panelWrap = component.querySelector(".configurator_panel_wrap");
        const panels = component.querySelectorAll(".configurator_panel");
        const stepItems = component.querySelectorAll(".configurator_step_item");
        const targets = component.querySelectorAll(".configurator_target");
        const selections = { produkt: "", typ: "", pohon: "" };

        const showStep = (stepNumber) => {
          panels.forEach((panel) => {
            panel.classList.toggle("is-active", panel.dataset.stepPanel === String(stepNumber));
          });
          stepItems.forEach((item) => {
            item.classList.toggle("is-active", item.dataset.stepIndicator === String(stepNumber));
          });
          if (panelWrap instanceof HTMLElement) {
            panelWrap.style.setProperty("--configurator-progress", String(stepNumber));
          }
        };

        // --- Line-art "drawing" reveal, plain CSS transitions (no library) ---
        const houseSvg = component.querySelector(".configurator_house_svg");
        const drawEls = houseSvg ? Array.from(houseSvg.querySelectorAll("[data-draw]")) : [];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        drawEls.forEach((el, index) => {
          const length = typeof el.getTotalLength === "function" ? el.getTotalLength() : 0;
          el.style.strokeDasharray = String(length);
          el.style.strokeDashoffset = reduceMotion ? "0" : String(length);
          if (!reduceMotion) {
            el.style.transition = `stroke-dashoffset 1.1s ease-out ${index * 12}ms`;
          }
        });

        if (!reduceMotion && houseSvg && drawEls.length) {
          const drawObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                drawEls.forEach((el) => {
                  el.style.strokeDashoffset = "0";
                });
                drawObserver.disconnect();
              });
            },
            { threshold: 0.25 }
          );
          drawObserver.observe(houseSvg);
        }

        // --- Detail card: fades in beside the house for the picked product ---
        const detailCard = component.querySelector("[data-detail-card]");
        const detailTitle = component.querySelector("[data-detail-title]");
        const detailText = component.querySelector("[data-detail-text]");
        const detailIconPath = component.querySelector("[data-detail-icon-path]");

        // Both boxes can be picked at once (e.g. someone needs the garage
        // door and the gate done together), so ids/labels are small arrays.
        const showDetail = (ids) => {
          const picked = produktOptions.filter((item) => ids.includes(item.id));
          if (!picked.length || !(detailCard instanceof HTMLElement)) return;
          if (detailTitle) detailTitle.textContent = picked.map((item) => item.value).join(" + ");
          if (detailText) detailText.textContent = picked.map((item) => item.text).join(" ");
          if (detailIconPath) detailIconPath.setAttribute("d", picked[0].path);
          detailCard.style.opacity = "1";
          detailCard.style.transform = "translateY(0)";
          detailCard.style.pointerEvents = "auto";
        };

        const hideDetail = () => {
          if (!(detailCard instanceof HTMLElement)) return;
          detailCard.style.opacity = "0";
          detailCard.style.transform = "translateY(0.75rem)";
          detailCard.style.pointerEvents = "none";
        };

        const highlightTargets = (ids) => {
          targets.forEach((target) => {
            target.classList.toggle("is-active", ids.includes(target.id));
          });
          if (houseSvg) houseSvg.classList.toggle("has-active", ids.length > 0);
          if (ids.length > 0) {
            showDetail(ids);
          } else {
            hideDetail();
          }
        };

        // Plain buttons instead of hidden radio/checkbox inputs: a click
        // listener directly on the visible card is the simplest thing that
        // can't silently miss, unlike a tiny hidden form control under it.
        const setupOptionGroup = (groupName, { multi = false } = {}) => {
          const buttons = Array.from(
            component.querySelectorAll(`[data-option-group="${groupName}"]`)
          );
          buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
              if (multi) {
                btn.classList.toggle("is-active");
              } else {
                buttons.forEach((other) => other.classList.toggle("is-active", other === btn));
              }
              buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.classList.contains("is-active"))));

              const active = buttons.filter((b) => b.classList.contains("is-active"));
              selections[groupName] = active.map((b) => b.dataset.optionValue ?? "").join(" + ");

              if (groupName === "produkt") {
                highlightTargets(active.map((b) => b.dataset.target ?? "").filter(Boolean));
              }

              const panel = btn.closest(".configurator_panel");
              const nextButton = panel ? panel.querySelector('[data-action="next"]') : null;
              if (nextButton) nextButton.disabled = active.length === 0;
            });
          });
        };

        setupOptionGroup("produkt", { multi: true });
        setupOptionGroup("typ");
        setupOptionGroup("pohon");

        component.querySelectorAll('[data-action="next"]').forEach((button) => {
          button.addEventListener("click", () => {
            const currentStep = Number(button.closest(".configurator_panel").dataset.stepPanel);
            if (currentStep === 3) {
              component.querySelector('[data-summary="produkt"]').textContent = selections.produkt;
              component.querySelector('[data-summary="typ"]').textContent = selections.typ;
              component.querySelector('[data-summary="pohon"]').textContent = selections.pohon;
            }
            showStep(currentStep + 1);
          });
        });

        component.querySelectorAll('[data-action="back"]').forEach((button) => {
          button.addEventListener("click", () => {
            const currentPanel = button.closest(".configurator_panel") ?? button.closest("[data-step-panel]");
            const currentStep = Number(currentPanel.dataset.stepPanel);
            showStep(currentStep - 1);
          });
        });

        const contactLink = component.querySelector('[data-action="goto-contact"]');
        if (contactLink) {
          contactLink.addEventListener("click", () => {
            // Reaches outside this component on purpose: prefills the contact
            // form's message field with the configurator selections.
            const message = document.querySelector("[data-contact-message]");
            if (message && !message.value) {
              message.value = `${summaryLabels.produkt}: ${selections.produkt}. ${summaryLabels.typ}: ${selections.typ}. ${summaryLabels.pohon}: ${selections.pohon}.`;
            }
          });
        }
      });
    });
  </script>
</section>
